# ---------------------------------------------------------------------------
# Anything prefixed VITE_ is inlined into the PUBLIC browser bundle.
# Never put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# Brand contact details (safe to expose)
VITE_WHATSAPP_NUMBER=919901200520
VITE_INSTAGRAM_URL=https://www.instagram.com/kandammakids
VITE_FACEBOOK_URL=https://www.facebook.com/kandammakids

# ---------------------------------------------------------------------------
# SERVER-ONLY. Set these in the Vercel dashboard (Project -> Settings ->
# Environment Variables). They are read by /api/stylist and are never sent
# to the browser.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Optional override, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
