rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// Storefront data is world-readable, but ONLY signed-in admin accounts may
// write. Add each owner's Firebase Auth UID to the list below (Firebase
// console -> Authentication -> Users -> copy the UID).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          // TODO: replace with your real admin UID(s) before deploying.
          'REPLACE_WITH_YOUR_ADMIN_UID'
        ];
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
