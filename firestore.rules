rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check admin privileges
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "kandammakids@gmail.com" ||
        request.auth.token.email == "admin@kandammakids.com" ||
        request.auth.token.email == "karthikse1998@gmail.com" ||
        request.auth.uid == "kR51MoWMO6gj5nODnZ3rr6oM5CN2" ||
        request.auth.uid == "q4aCJhwF93hB4eOLUnlFgNbYvy03"
      );
    }

    // Products — public read, admin-only write
    match /products/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings (brand info) — public read, admin-only write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}